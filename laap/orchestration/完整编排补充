@dataclass
class ColoredToken:
    color: TokenColor; value: Any
    timestamp: float = field(default_factory=time.time)
    provenance: List[str] = field(default_factory=list)
    def with_provenance(self, place_id: str) -> ColoredToken:
        return ColoredToken(self.color, self.value, self.timestamp, self.provenance + [place_id])

@dataclass
class PetriPlace:
    place_id: str; capacity: int = -1
    tokens: deque = field(default_factory=lambda: deque(maxlen=10000))
    token_types: Set[TokenColor] = field(default_factory=set)

    def can_accept(self, token: ColoredToken) -> bool:
        if self.token_types and token.color not in self.token_types: return False
        if self.capacity > 0 and len(self.tokens) >= self.capacity: return False
        return True

    def deposit(self, token: ColoredToken) -> bool:
        if not self.can_accept(token): return False
        self.tokens.append(token.with_provenance(self.place_id))
        return True

    def withdraw(self, color: Optional[TokenColor] = None) -> Optional[ColoredToken]:
        if not self.tokens: return None
        if color is None: return self.tokens.popleft()
        for i, tok in enumerate(self.tokens):
            if tok.color == color:
                del self.tokens[i]; return tok
        return None

@dataclass
class PetriTransition:
    transition_id: str
    input_places: Dict[str, int] = field(default_factory=dict)
    output_places: Dict[str, Callable] = field(default_factory=dict)
    guard: Callable = field(default=lambda _: True)
    action: Optional[Callable] = None
    is_enabled: bool = True

    def can_fire(self, net: PetriNet) -> bool:
        for place_id, count in self.input_places.items():
            place = net.places.get(place_id)
            if not place or len(place.tokens) < count: return False
        tokens = {pid: list(place.tokens)[:cnt] for pid, cnt in self.input_places.items()}
        return self.guard(tokens)

class PetriNet:
    def __init__(self, net_id: str):
        self.net_id = net_id
        self.places: Dict[str, PetriPlace] = {}
        self.transitions: Dict[str, PetriTransition] = {}
        self._lock = asyncio.Lock()
        self._execution_log: List[Dict] = []

    def add_place(self, place_id: str, capacity: int = -1,
                  token_types: Optional[Set[TokenColor]] = None) -> PetriPlace:
        place = PetriPlace(place_id, capacity, token_types=token_types or set())
        self.places[place_id] = place
        return place

    def add_transition(self, transition: PetriTransition) -> None:
        self.transitions[transition.transition_id] = transition

    async def fire_transition(self, transition_id: str) -> bool:
        async with self._lock:
            transition = self.transitions.get(transition_id)
            if not transition or not transition.can_fire(self): return False
            consumed: Dict[str, List[ColoredToken]] = {}
            for place_id, count in transition.input_places.items():
                place = self.places[place_id]
                tokens = []
                for _ in range(count):
                    tok = place.withdraw()
                    if tok: tokens.append(tok)
                consumed[place_id] = tokens
            if transition.action:
                try:
                    result = transition.action(consumed)
                    if asyncio.iscoroutine(result): result = await result
                    if result is not None: consumed["_result"] = result
                except Exception as e:
                    logger.error(f"Transition {transition_id} failed: {e}")
                    for place_id, tokens in consumed.items():
                        if place_id.startswith("_"): continue
                        for tok in tokens: self.places[place_id].deposit(tok)
                    return False
            for place_id, transform in transition.output_places.items():
                input_tokens = consumed.get("_result", consumed.get(list(consumed.keys())[0], []))
                new_tokens = transform(input_tokens if isinstance(input_tokens, list) else [input_tokens])
                for tok in new_tokens: self.places[place_id].deposit(tok)
            self._execution_log.append({
                "transition": transition_id, "timestamp": time.time(),
                "consumed": {k: len(v) for k, v in consumed.items() if not k.startswith("_")}
            })
            return True

    async def get_enabled_transitions(self) -> List[str]:
        enabled = []
        for tid, trans in self.transitions.items():
            if trans.can_fire(self): enabled.append(tid)
        return enabled

    async def step(self) -> Optional[str]:
        enabled = await self.get_enabled_transitions()
        if not enabled: return None
        enabled.sort(key=lambda tid: getattr(self.transitions[tid], "priority", 0), reverse=True)
        chosen = enabled[0]
        return chosen if await self.fire_transition(chosen) else None

